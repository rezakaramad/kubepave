[[- /* Square-bracket delimiters keep Argo CD's own curly-brace expressions intact. Settings come from the Composition. */ -]]
[[- $settings := index .context "xtenant-settings" ]]
[[- $oidcAccessor := $settings.oidcAccessor | default "" ]]
[[- $tenant := .observed.composite.resource.metadata.name ]]
[[- $short := .observed.composite.resource.spec.shortName ]]
[[- $project := $settings.project ]]
[[- $argoNamespace := $settings.argoNamespace ]]
[[- $tenantLabel := $settings.tenantLabelKey ]]
[[- $repo := $settings.repoURL ]]
[[- $envLabel := $settings.environmentLabelKey ]]
[[- $typeLabel := $settings.clusterTypeLabelKey ]]
[[- $environments := $settings.environments ]]

[[- $appName := printf "xtenant-application-management-%s" $tenant ]]
[[- $setName := printf "xtenant-applicationset-workload-%s" $tenant ]]

[[- $app := getComposedResource . $appName | default dict ]]
[[- $appReady := and (eq (dig "status" "health" "status" "" $app) "Healthy") (eq (dig "status" "sync" "status" "" $app) "Synced") ]]

[[- $set := getComposedResource . $setName | default dict ]]
[[- $setReady := eq (print (getResourceCondition "ResourcesUpToDate" $set).Status) "True" ]]
---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: [[ $tenant ]]-management
  namespace: [[ $argoNamespace ]]
  labels:
    [[ $tenantLabel ]]: [[ $tenant ]]
  finalizers:
    - resources-finalizer.argocd.argoproj.io
  annotations:
    [[ setResourceNameAnnotation $appName ]]
    gotemplating.fn.crossplane.io/ready: [[ if $appReady ]]"True"[[ else ]]"False"[[ end ]]
spec:
  project: [[ $project ]]
  source:
    repoURL: [[ $repo ]]
    path: kubernetes/charts/tenant-management
    targetRevision: HEAD
    helm:
      parameters:
        - {name: tenant.name, value: [[ $tenant | quote ]]}
        - {name: tenant.tenantShortName, value: [[ $short | quote ]]}
        - {name: vault.enabled, value: "true"}
        [[- if $oidcAccessor ]]
        - {name: vault.oidc.enabled, value: "true"}
        - {name: vault.oidc.mountAccessor, value: [[ $oidcAccessor | quote ]]}
        [[- end ]]
  destination:
    name: in-cluster
    namespace: tenant-system
  syncPolicy:
    # Readiness requires Synced, so the Application must converge on its own.
    automated:
      selfHeal: true
    syncOptions:
      - ServerSideApply=true
      - ApplyOutOfSyncOnly=true
      - RespectIgnoreDifferences=true
---
apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: [[ $tenant ]]-workload
  namespace: [[ $argoNamespace ]]
  labels:
    [[ $tenantLabel ]]: [[ $tenant ]]
  annotations:
    [[ setResourceNameAnnotation $setName ]]
    gotemplating.fn.crossplane.io/ready: [[ if $setReady ]]"True"[[ else ]]"False"[[ end ]]
spec:
  goTemplate: true
  goTemplateOptions: ["missingkey=error"]
  generators:
    - clusters:
        selector:
          matchExpressions:
            - key: [[ $typeLabel ]]
              operator: In
              values: [tenant]
            - key: [[ $envLabel ]]
              operator: In
              values:
                [[- range $environments ]]
                - [[ . ]]
                [[- end ]]
        template:
          metadata:
            name: '[[ $tenant ]]-workload-{{ index .metadata.labels "[[ $envLabel ]]" }}'
            labels:
              [[ $tenantLabel ]]: [[ $tenant ]]
          spec:
            project: [[ $project ]]
            source:
              repoURL: [[ $repo ]]
              path: kubernetes/charts/tenant-workload
              targetRevision: HEAD
              helm:
                valueFiles:
                  - values-local.yaml
                  - 'values-local-{{ index .metadata.labels "[[ $envLabel ]]" }}.yaml'
                parameters:
                  - {name: tenant.name, value: [[ $tenant | quote ]]}
                  - {name: tenant.tenantShortName, value: [[ $short | quote ]]}
                  - {name: vault.enabled, value: "true"}
            destination:
              name: '{{ .name }}'
              namespace: [[ $tenant ]]
  template:
    metadata:
      labels:
        [[ $tenantLabel ]]: [[ $tenant ]]
    spec:
      project: [[ $project ]]
      syncPolicy:
        syncOptions:
          - ServerSideApply=true
          - ApplyOutOfSyncOnly=true
          - RespectIgnoreDifferences=true
  ignoreApplicationDifferences:
    - jsonPointers:
        - /spec/syncPolicy
---
apiVersion: meta.gotemplating.fn.crossplane.io/v1alpha1
kind: ClaimConditions
conditions:
  - type: ArgoCDManagementApplicationReady
    status: [[ if $appReady ]]"True"[[ else ]]"False"[[ end ]]
    reason: [[ if $appReady ]]Available[[ else ]]Unavailable[[ end ]]
    target: Composite
  - type: ArgoCDWorkloadApplicationSetReady
    status: [[ if $setReady ]]"True"[[ else ]]"False"[[ end ]]
    reason: [[ if $setReady ]]Available[[ else ]]Unavailable[[ end ]]
    target: Composite
